---
// src/pages/index.astro — Inicio (pseudo-landing + internal linking)
import BaseLayout from '@/layouts/BaseLayout.astro';
import Img from '@/components/ui/Img.astro';
import Glyph from '@/components/ui/Glyph.astro';
import CarCard from '@/components/ui/CarCard.astro';
import { inventory } from '@/data/inventory';
import { whatsappNumber } from '@/data/site';
import { href, formatCOP, formatKm } from '@/lib/url';

const title = 'AutoCapital | Carros premium usados en Bogotá y Colombia';
const description =
  'Compra un carro premium con historial verificado, vende o consigna el tuyo y financia tu próxima compra. Concesionario 100% digital en Bogotá.';

const heroCar = inventory.find((c) => c.slug === 'mercedes-benz-glc-300e')!;
const featured = inventory.slice(0, 6);

const services = [
  { key: 'comprar', image: 'hero-catalogo.jpg', title: 'Comprar un carro', text: 'Inventario curado de vehículos premium, revisados y con documentación al día.', url: '/catalogo', cta: 'Ver catálogo' },
  { key: 'vender', image: 'hero-venta.jpg', title: 'Vender tu carro', text: 'Te damos una oferta y te pagamos rápido, sin intermediarios ni regateo eterno.', url: '/vende-tu-carro', cta: 'Cotizar mi carro' },
  { key: 'consignar', image: 'hero-consignacion.jpg', title: 'Consignar tu carro', text: 'Lo publicamos, lo mostramos y negociamos por ti para que obtengas mejor precio.', url: '/consignacion', cta: 'Cómo funciona' },
  { key: 'financiar', image: 'hero-financiacion.jpg', title: 'Financiar tu compra', text: 'Simula tu cuota y te acompañamos en la solicitud con nuestras entidades aliadas.', url: '/financiacion', cta: 'Simular cuota' },
];

const pillars = [
  { title: 'Inventario premium en línea', text: 'Un catálogo de vehículos de alta gama que puedes explorar sin moverte de casa.' },
  { title: 'Asesoría 100% online', text: 'Te acompañamos desde la elección hasta la entrega, sin presiones ni vendedores insistentes.' },
  { title: 'Trámites gestionados', text: 'Traspasos, matrículas, seguros, impuestos y fotomultas, con cobertura nacional.' },
  { title: 'Entrega en todo el país', text: 'Desde Bogotá hasta tu puerta, listo para rodar.' },
];

const testimonials = [
  { title: 'Compra rápida y confiable', quote: 'Compré un Audi Q3 2020 en AutoCapital y la experiencia fue excelente. Todo el proceso digital, rápido y seguro. Me entregaron el carro en perfectas condiciones y con la documentación lista.' },
  { title: 'Buen historial y transparencia', quote: 'Adquirí un Mercedes-Benz A200 2019. Me sorprendió la transparencia en el historial del carro y la facilidad para hacer la transacción. Se nota que curan muy bien el inventario.' },
  { title: 'Venta sencilla y justa', quote: 'Vendí mi Kia Sportage 2021 con AutoCapital. Me ofrecieron un precio justo y en pocos días ya tenía el dinero en mi cuenta. El proceso fue mucho más sencillo que en un concesionario tradicional.' },
];
---

<BaseLayout title={title} description={description} headerVariant="overlay">
  <!-- Hero: foto a sangre completa con parallax -->
  <section class="hero on-dark">
    <div class="hero__bg">
      <div class="hero__plx" data-parallax="0.32">
        <Img src="hero-inicio.jpg" alt="Deportivo rodando por una autopista al atardecer" priority sizes="100vw" widths={[768, 1024, 1440, 1600]} quality={65} />
      </div>
    </div>
    <div class="hero__shade" aria-hidden="true"></div>

    <div class="container hero__inner">
      <div class="hero__text">
        <p class="hero__status enter" style="--d:100ms"><span class="dot" aria-hidden="true"></span><span class="num">{inventory.length}</span> carros disponibles hoy</p>
        <h1 class="enter--mask" style="--d:180ms"><span>El auto que mereces,</span><span>a un clic de distancia</span></h1>
        <p class="hero__lead enter" style="--d:420ms">Carros premium con historial verificado, procesos sin presión y toda Colombia como vitrina.</p>
        <div class="hero__actions enter" style="--d:520ms">
          <a href={href('/catalogo')} class="btn btn--primary">Ver catálogo <Glyph name="arrow" /></a>
          <a href={href('/vende-tu-carro')} class="btn btn--line">Vender mi carro</a>
        </div>
      </div>

      <a href={href('/catalogo')} class="hero__pick enter" style="--d:700ms" aria-label={`Recién llegado: ${heroCar.name} ${heroCar.year}, ver en el catálogo`}>
        <span class="hero__pick-tag">Recién llegado</span>
        <span class="hero__pick-name">{heroCar.name}</span>
        <span class="hero__pick-meta num">{heroCar.year} · {formatKm(heroCar.km)} · {formatCOP(heroCar.priceCOP)}</span>
        <Glyph name="arrow" />
      </a>
    </div>
  </section>

  <!-- Servicios: índice de internal linking -->
  <section class="section services" id="servicios" aria-labelledby="servicios-h">
    <div class="container services__grid">
      <div class="services__head reveal">
        <h2 id="servicios-h">¿Qué necesitas hoy?</h2>
        <p>Compra, venta, consignación o financiación: todo el proceso en un solo lugar y en línea.</p>
      </div>
      <div class="services__wrap" data-preview-list>
      <ul class="services__list">
        {services.map((s, i) => (
          <li class="reveal" style={`transition-delay:${i * 80}ms`}>
            <a href={href(s.url)} class="service" data-preview-key={s.key}>
              <span class="service__title">{s.title}</span>
              <span class="service__text">{s.text}</span>
              <span class="service__cta">{s.cta} <Glyph name="arrow" /></span>
            </a>
          </li>
        ))}
      </ul>
      <div class="preview" data-preview aria-hidden="true">
        {services.map((s) => (
          <div class="preview__frame" data-preview-frame={s.key}>
            <Img src={s.image} alt="" sizes="320px" widths={[480]} />
          </div>
        ))}
      </div>
      </div>
    </div>
  </section>

  <!-- Recién llegados -->
  <section class="section section--paper" aria-labelledby="destacados-h">
    <div class="container">
      <div class="row-head reveal">
        <h2 id="destacados-h">Recién llegados</h2>
        <a href={href('/catalogo')} class="link-arrow">Ver los {inventory.length} carros <Glyph name="arrow" /></a>
      </div>
      <div class="grid-cars">
        {featured.map((car) => <CarCard car={car} />)}
      </div>
    </div>
  </section>

  <!-- Quiénes somos: franja con foto en parallax -->
  <section class="band on-dark" id="quienes-somos" aria-labelledby="about-h">
    <div class="band__bg">
      <div class="band__plx" data-parallax="0.14">
        <Img src="band-nosotros.jpg" alt="" sizes="100vw" widths={[768, 1024, 1281]} />
      </div>
    </div>
    <div class="band__shade" aria-hidden="true"></div>
    <div class="container band__inner reveal">
      <h2 id="about-h">¿Quiénes somos?</h2>
      <p class="band__lead">AutoCapital no es un concesionario común.</p>
      <p class="band__text">Nacimos en Bogotá para redefinir la forma de comprar y vender autos premium en Colombia.</p>
    </div>
  </section>

  <section class="section about" aria-label="Cómo trabajamos">
    <div class="container about__grid">
      <p class="about__lead reveal">Operamos 100% en digital, con un inventario cuidadosamente seleccionado de vehículos de alta gama, listos para enamorarte desde el primer clic.</p>
      <dl class="about__pillars">
        {pillars.map((p, i) => (
          <div class="reveal" style={`transition-delay:${i * 90}ms`}>
            <dt>{p.title}</dt>
            <dd>{p.text}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Testimonios -->
  <section class="section section--tight quotes" aria-labelledby="quotes-h">
    <div class="container">
      <h2 id="quotes-h" class="quotes__h reveal">Lo que dicen nuestros clientes</h2>
      <div class="quotes__grid">
        {testimonials.map((t) => (
          <figure class="quote reveal">
            <p class="quote__stars" role="img" aria-label="5 de 5 estrellas">
              {[0, 1, 2, 3, 4].map(() => <Glyph name="star" />)}
            </p>
            <blockquote><p>{t.quote}</p></blockquote>
            <figcaption>{t.title}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA contacto -->
  <section class="section section--dark on-dark contact" id="contacto" aria-labelledby="contacto-h">
    <div class="contact__bg" aria-hidden="true">
      <div class="contact__plx" data-parallax="0.1">
        <Img src="band-contacto.jpg" alt="" sizes="100vw" widths={[768, 1024, 1536]} quality={55} />
      </div>
    </div>
    <div class="container contact__grid">
      <div class="contact__text reveal">
        <h2 id="contacto-h">¿Hablamos?<br />Sin compromiso.</h2>
        <p>Escríbenos por WhatsApp y un asesor te responde. Cuéntanos qué carro buscas o cuál quieres vender.</p>
        <a href="https://www.instagram.com/autocapital.co/" class="contact__ig" target="_blank" rel="noopener">
          <Glyph name="instagram" /> Síguenos en Instagram · @autocapital.co
        </a>
      </div>
      <form class="contact__form reveal" data-wa-form data-wa-number={whatsappNumber} data-wa-intro="Hola AutoCapital, les escribo desde la web.">
        <div class="field">
          <label for="c-nombre">Nombre</label>
          <input id="c-nombre" name="nombre" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="c-tel">Teléfono</label>
          <input id="c-tel" name="telefono" type="tel" autocomplete="tel" inputmode="tel" required />
        </div>
        <fieldset class="field contact__interest">
          <legend class="label">Me interesa</legend>
          <div class="chips">
            {['Comprar', 'Vender', 'Consignar', 'Financiar'].map((o, i) => (
              <label class="chip"><input type="radio" name="interes" value={o} data-label="Me interesa" checked={i === 0} /><span>{o}</span></label>
            ))}
          </div>
        </fieldset>
        <div class="field contact__msg">
          <label for="c-msg">Mensaje (opcional)</label>
          <textarea id="c-msg" name="mensaje" rows="3" placeholder="Ej.: busco una SUV automática 2021 en adelante"></textarea>
        </div>
        <div class="contact__submit">
          <button type="submit" class="btn btn--primary"><Glyph name="whatsapp" /> Enviar por WhatsApp</button>
          <p class="form-note">Al enviar se abre WhatsApp con tu mensaje listo.</p>
        </div>
        <p class="form-ok" data-wa-status hidden role="status"></p>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  import { initWaForms } from '@/lib/waForm';
  initWaForms();
</script>

<style>
  /* Hero */
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    min-height: max(36rem, min(100svh, 62rem));
    padding-top: calc(76px + 3rem);
    padding-bottom: clamp(2.5rem, 6vw, 4.5rem);
    background: var(--color-graphite);
    color: var(--color-on-dark);
    overflow: hidden;
  }
  .hero__bg { position: absolute; inset: 0; z-index: -2; overflow: hidden; }
  .hero__plx { position: absolute; inset: -4% 0 -8%; }
  .hero__plx :global(picture), .hero__plx :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 62% 60%; }
  @media (max-width: 640px) { .hero__plx :global(img) { object-position: 70% 40%; } }
  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgba(12, 19, 34, 0.72) 0%, rgba(12, 19, 34, 0) 24%),
      linear-gradient(0deg, rgba(12, 19, 34, 0.95) 0%, rgba(12, 19, 34, 0.5) 40%, rgba(12, 19, 34, 0) 70%),
      linear-gradient(90deg, rgba(12, 19, 34, 0.78) 0%, rgba(12, 19, 34, 0.2) 55%, rgba(12, 19, 34, 0) 80%);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__plx :global(img) { animation: develop 2s cubic-bezier(0.16, 1, 0.3, 1) both; }
    .dot { animation: pulse 2.4s ease-out infinite; }
  }
  @keyframes develop {
    from { transform: scale(1.12); filter: brightness(0.5); }
    to { transform: none; filter: none; }
  }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(47, 182, 124, 0.5); }
    70%, 100% { box-shadow: 0 0 0 10px rgba(47, 182, 124, 0); }
  }
  .hero__inner { display: grid; gap: 2.5rem; align-items: end; }
  @media (min-width: 1024px) { .hero__inner { grid-template-columns: 1fr auto; gap: 4rem; } }
  .hero__text { display: grid; gap: 1.5rem; justify-items: start; }
  .hero__status { display: inline-flex; align-items: center; gap: 0.6rem; font-size: var(--text-small); color: #c9cdd6; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--color-signal); }
  .hero h1 { font-size: clamp(2.7rem, 7.4vw, 6rem); line-height: 0.96; letter-spacing: -0.038em; font-weight: 600; max-width: 18ch; }
  .hero h1 > span { display: block; }
  .hero h1 > span + span { animation-delay: calc(var(--d) + 110ms); }
  .hero__lead { font-size: var(--text-lead); color: #c9cdd6; max-width: 34rem; line-height: 1.5; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.4rem; }

  /* Ficha del recién llegado, sobre la foto */
  .hero__pick {
    position: relative;
    display: grid;
    gap: 0.2rem;
    min-width: 17rem;
    padding: 1.1rem 3.2rem 1.1rem 1.2rem;
    background: rgba(12, 19, 34, 0.82);
    border: 1px solid var(--color-line-dark);
    border-radius: var(--radius-md);
    color: var(--color-on-dark);
    transition: background-color 0.3s var(--ease-out), border-color 0.3s var(--ease-out);
  }
  .hero__pick-tag { font-size: var(--text-xs); color: var(--color-on-dark-muted); }
  .hero__pick-name { font-weight: 600; font-size: 1.1rem; letter-spacing: -0.015em; }
  .hero__pick-meta { font-size: 0.85rem; color: #c9cdd6; }
  .hero__pick :global(svg) { position: absolute; right: 1.1rem; top: 50%; width: 1.2rem; height: 1.2rem; translate: 0 -50%; transition: transform 0.35s var(--ease-out); }
  .hero__pick:hover { color: #fff; background: rgba(12, 19, 34, 0.94); border-color: rgba(242, 241, 237, 0.32); }
  .hero__pick:hover :global(svg) { transform: translateX(4px); }

  /* Servicios */
  .services__grid { display: grid; gap: 2.5rem; }
  @media (min-width: 1024px) { .services__grid { grid-template-columns: 0.8fr 1.2fr; gap: 5rem; } .services__head { position: sticky; top: 120px; align-self: start; } }
  .services__head { display: grid; gap: 1rem; }
  .services__head p { color: var(--color-ink-500); font-size: var(--text-lead); line-height: 1.5; max-width: 26rem; }
  .services__list { list-style: none; border-top: 1px solid var(--color-ink); }
  .service {
    display: grid;
    gap: 0.4rem 2rem;
    padding: 1.6rem 0;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-ink);
  }
  @media (min-width: 640px) { .service { grid-template-columns: 1fr auto; } .service__text { grid-column: 1; } .service__cta { grid-column: 2; grid-row: 1 / span 2; align-self: center; } }
  .service__title { font-size: clamp(1.4rem, 2.4vw, 1.9rem); font-weight: 600; letter-spacing: -0.025em; line-height: 1.15; transition: transform 0.45s var(--ease-out); }
  .service__text { color: var(--color-ink-500); max-width: 40ch; }
  .service__cta { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 560; font-size: 0.95rem; color: var(--color-brand-ink); white-space: nowrap; }
  .service__cta :global(svg) { width: 1.1rem; height: 1.1rem; transition: transform 0.35s var(--ease-out); }
  .service:hover { color: var(--color-ink); }
  .service:hover .service__title { transform: translateX(6px); }
  .service:hover .service__cta :global(svg) { transform: translateX(5px); }

  /* Vista previa que sigue al cursor (solo escritorio con mouse) */
  .services__wrap { position: relative; }
  .preview {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    width: 19rem;
    aspect-ratio: 4 / 3;
    pointer-events: none;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-graphite);
    box-shadow: 0 24px 48px -16px rgba(12, 19, 34, 0.45);
    clip-path: inset(50% 50% 50% 50% round 6px);
    opacity: 0;
    transition: clip-path 0.55s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
    display: none;
  }
  @media (hover: hover) and (pointer: fine) and (min-width: 1024px) { .preview { display: block; } }
  .preview:global(.is-on) { clip-path: inset(0 0 0 0 round 6px); opacity: 1; }
  .preview__frame { position: absolute; inset: 0; opacity: 0; transform: scale(1.1); transition: opacity 0.35s ease, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1); }
  .preview__frame:global(.is-current) { opacity: 1; transform: none; }
  .preview__frame :global(picture), .preview__frame :global(img) { width: 100%; height: 100%; object-fit: cover; }


  /* Recién llegados */
  .row-head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 2.25rem; }
  .grid-cars { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); }
  @media (min-width: 1100px) { .grid-cars { grid-template-columns: repeat(3, 1fr); gap: 1.5rem; } }

  /* Quiénes somos: franja con foto */
  .band {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    min-height: clamp(30rem, 78svh, 46rem);
    padding-block: clamp(4rem, 9vw, 7rem);
    color: var(--color-on-dark);
    background: var(--color-graphite);
    overflow: hidden;
  }
  .band__bg { position: absolute; inset: 0; z-index: -2; overflow: hidden; }
  .band__plx { position: absolute; inset: -18% 0; }
  .band__plx :global(picture), .band__plx :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 62%; }
  .band__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(0deg, rgba(12, 19, 34, 0.92) 0%, rgba(12, 19, 34, 0.35) 55%, rgba(12, 19, 34, 0.15) 100%),
      linear-gradient(90deg, rgba(12, 19, 34, 0.75) 0%, rgba(12, 19, 34, 0) 70%);
  }
  .band__inner { display: grid; gap: 1rem; justify-items: start; }
  .band__inner h2 { font-size: var(--text-h3); color: #c9cdd6; font-weight: 560; letter-spacing: -0.01em; }
  .band__lead { font-size: clamp(2rem, 5vw, 3.75rem); font-weight: 600; letter-spacing: -0.032em; line-height: 1.02; max-width: 16ch; text-wrap: balance; }
  .band__text { color: #c9cdd6; font-size: var(--text-lead); max-width: 34rem; line-height: 1.5; }

  .about__grid { display: grid; gap: 3rem; }
  @media (min-width: 1024px) { .about__grid { grid-template-columns: 1fr 1fr; gap: 5rem; } }
  .about__lead { font-size: clamp(1.3rem, 2.2vw, 1.7rem); font-weight: 520; letter-spacing: -0.02em; line-height: 1.3; max-width: 30rem; }
  .about__pillars { display: grid; gap: 0; align-content: start; }
  @media (min-width: 640px) { .about__pillars { grid-template-columns: 1fr 1fr; column-gap: 2rem; } }
  .about__pillars div { padding: 1.4rem 0 1.6rem; border-top: 1px solid var(--color-line); display: grid; gap: 0.45rem; }
  .about__pillars dt { font-weight: 600; font-size: 1.08rem; letter-spacing: -0.01em; }
  .about__pillars dd { color: var(--color-ink-500); font-size: 0.96rem; }

  /* Testimonios */
  .quotes { border-top: 1px solid var(--color-line); }
  .quotes__h { font-size: var(--text-h3); margin-bottom: 2.25rem; }
  .quotes__grid { display: grid; gap: 2.5rem; }
  @media (min-width: 900px) { .quotes__grid { grid-template-columns: repeat(3, 1fr); gap: 0; } .quote { padding-inline: 2rem; } .quote:first-child { padding-left: 0; } .quote + .quote { border-left: 1px solid var(--color-line); } }
  .quote { display: grid; gap: 1rem; align-content: start; }
  .quote__stars { display: flex; gap: 2px; color: var(--color-brand); }
  .quote__stars :global(svg) { width: 0.95rem; height: 0.95rem; }
  .quote blockquote p { font-size: 1.08rem; line-height: 1.55; letter-spacing: -0.005em; }
  .quote figcaption { font-size: var(--text-small); color: var(--color-ink-500); font-weight: 540; }

  /* Contacto */
  .contact { position: relative; isolation: isolate; overflow: hidden; }
  .contact__bg { position: absolute; inset: 0; z-index: -1; overflow: hidden; }
  .contact__bg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(12, 19, 34, 0.8) 0%, rgba(12, 19, 34, 0.93) 55%, var(--color-graphite) 100%); }
  .contact__plx { position: absolute; inset: -14% 0; }
  .contact__plx :global(picture), .contact__plx :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 40% 60%; }
  .contact__grid { display: grid; gap: 3rem; }
  @media (min-width: 1024px) { .contact__grid { grid-template-columns: 0.9fr 1.1fr; gap: 5rem; } }
  .contact__text { display: grid; gap: 1.25rem; align-content: start; }
  .contact__text h2 { font-size: var(--text-h1); line-height: 1.02; }
  .contact__text p { color: var(--color-on-dark-muted); font-size: var(--text-lead); line-height: 1.5; max-width: 30rem; }
  .contact__ig { display: inline-flex; align-items: center; gap: 0.6rem; color: var(--color-on-dark); font-weight: 520; }
  .contact__ig :global(svg) { width: 1.2rem; height: 1.2rem; }
  .contact__ig:hover { color: #fff; text-decoration: underline; }
  .contact__form { display: grid; gap: 1.1rem; grid-template-columns: 1fr; }
  @media (min-width: 640px) { .contact__form { grid-template-columns: 1fr 1fr; } .contact__interest, .contact__msg, .contact__submit, .form-ok { grid-column: 1 / -1; } }
  fieldset { border: 0; min-width: 0; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip { position: relative; cursor: pointer; }
  .chip input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .chip span {
    display: inline-flex;
    align-items: center;
    height: 2.6rem;
    padding: 0 1.1rem;
    border: 1px solid rgba(242, 241, 237, 0.24);
    border-radius: var(--radius-sm);
    font-size: 0.93rem;

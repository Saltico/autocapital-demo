---
// src/pages/index.astro — Inicio (pseudo-landing + internal linking)
import BaseLayout from '@/layouts/BaseLayout.astro';
import Img from '@/components/ui/Img.astro';
import Glyph from '@/components/ui/Glyph.astro';
import CarCard from '@/components/ui/CarCard.astro';
import { inventory } from '@/data/inventory';
import { whatsappNumber } from '@/data/site';
import { href, formatCOP, formatKm } from '@/lib/url';

const title = 'AutoCapital | Carros premium usados en Bogotá y Colombia';
const description =
  'Compra un carro premium con historial verificado, vende o consigna el tuyo y financia tu próxima compra. Concesionario 100% digital en Bogotá.';

const heroCar = inventory.find((c) => c.slug === 'mercedes-benz-glc-300e')!;
const featured = inventory.slice(0, 6);

const services = [
  { title: 'Comprar un carro', text: 'Inventario curado de vehículos premium, revisados y con documentación al día.', url: '/catalogo', cta: 'Ver catálogo' },
  { title: 'Vender tu carro', text: 'Te damos una oferta y te pagamos rápido, sin intermediarios ni regateo eterno.', url: '/vende-tu-carro', cta: 'Cotizar mi carro' },
  { title: 'Consignar tu carro', text: 'Lo publicamos, lo mostramos y negociamos por ti para que obtengas mejor precio.', url: '/consignacion', cta: 'Cómo funciona' },
  { title: 'Financiar tu compra', text: 'Simula tu cuota y te acompañamos en la solicitud con nuestras entidades aliadas.', url: '/financiacion', cta: 'Simular cuota' },
];

const pillars = [
  { title: 'Inventario premium en línea', text: 'Un catálogo de vehículos de alta gama que puedes explorar sin moverte de casa.' },
  { title: 'Asesoría 100% online', text: 'Te acompañamos desde la elección hasta la entrega, sin presiones ni vendedores insistentes.' },
  { title: 'Trámites gestionados', text: 'Traspasos, matrículas, seguros, impuestos y fotomultas, con cobertura nacional.' },
  { title: 'Entrega en todo el país', text: 'Desde Bogotá hasta tu puerta, listo para rodar.' },
];

const testimonials = [
  { title: 'Compra rápida y confiable', quote: 'Compré un Audi Q3 2020 en AutoCapital y la experiencia fue excelente. Todo el proceso digital, rápido y seguro. Me entregaron el carro en perfectas condiciones y con la documentación lista.' },
  { title: 'Buen historial y transparencia', quote: 'Adquirí un Mercedes-Benz A200 2019. Me sorprendió la transparencia en el historial del carro y la facilidad para hacer la transacción. Se nota que curan muy bien el inventario.' },
  { title: 'Venta sencilla y justa', quote: 'Vendí mi Kia Sportage 2021 con AutoCapital. Me ofrecieron un precio justo y en pocos días ya tenía el dinero en mi cuenta. El proceso fue mucho más sencillo que en un concesionario tradicional.' },
];
---

<BaseLayout title={title} description={description} headerVariant="overlay">
  <!-- Hero -->
  <section class="hero on-dark">
    <div class="container hero__grid">
      <div class="hero__text">
        <p class="hero__status"><span class="dot" aria-hidden="true"></span><span class="num">{inventory.length}</span> carros disponibles hoy</p>
        <h1>El auto que mereces, a un clic de distancia</h1>
        <p class="hero__lead">Carros premium con historial verificado, procesos sin presión y toda Colombia como vitrina.</p>
        <div class="hero__actions">
          <a href={href('/catalogo')} class="btn btn--primary">Ver catálogo <Glyph name="arrow" /></a>
          <a href={href('/vende-tu-carro')} class="btn btn--line">Vender mi carro</a>
        </div>
      </div>

      <a href={href('/catalogo')} class="hero__car" aria-label={`${heroCar.name} ${heroCar.year}, ver en el catálogo`}>
        <div class="hero__photo">
          <Img src={heroCar.image} alt={`${heroCar.name} ${heroCar.year} blanco en el showroom de AutoCapital`} priority sizes="(min-width: 1024px) 34vw, 90vw" widths={[480, 768]} />
        </div>
        <dl class="hero__spec">
          <div><dt>Modelo</dt><dd>{heroCar.name}</dd></div>
          <div><dt>Año</dt><dd class="num">{heroCar.year}</dd></div>
          <div><dt>Recorrido</dt><dd class="num">{formatKm(heroCar.km)}</dd></div>
          <div><dt>Precio</dt><dd class="num">{formatCOP(heroCar.priceCOP)}</dd></div>
        </dl>
      </a>
    </div>
  </section>

  <!-- Servicios: índice de internal linking -->
  <section class="section services" id="servicios" aria-labelledby="servicios-h">
    <div class="container services__grid">
      <div class="services__head reveal">
        <h2 id="servicios-h">¿Qué necesitas hoy?</h2>
        <p>Compra, venta, consignación o financiación: todo el proceso en un solo lugar y en línea.</p>
      </div>
      <ul class="services__list">
        {services.map((s) => (
          <li class="reveal">
            <a href={href(s.url)} class="service">
              <span class="service__title">{s.title}</span>
              <span class="service__text">{s.text}</span>
              <span class="service__cta">{s.cta} <Glyph name="arrow" /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Recién llegados -->
  <section class="section section--paper" aria-labelledby="destacados-h">
    <div class="container">
      <div class="row-head reveal">
        <h2 id="destacados-h">Recién llegados</h2>
        <a href={href('/catalogo')} class="link-arrow">Ver los {inventory.length} carros <Glyph name="arrow" /></a>
      </div>
      <div class="grid-cars">
        {featured.map((car) => <CarCard car={car} />)}
      </div>
    </div>
  </section>

  <!-- Quiénes somos -->
  <section class="section about" id="quienes-somos" aria-labelledby="about-h">
    <div class="container about__grid">
      <div class="about__text reveal">
        <h2 id="about-h">¿Quiénes somos?</h2>
        <p class="about__lead">AutoCapital no es un concesionario común.</p>
        <p>Nacimos en Bogotá para redefinir la forma de comprar y vender autos premium en Colombia.</p>
        <p>Operamos 100% en digital, con un inventario cuidadosamente seleccionado de vehículos de alta gama, listos para enamorarte desde el primer clic.</p>
      </div>
      <dl class="about__pillars">
        {pillars.map((p) => (
          <div class="reveal">
            <dt>{p.title}</dt>
            <dd>{p.text}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Testimonios -->
  <section class="section section--tight quotes" aria-labelledby="quotes-h">
    <div class="container">
      <h2 id="quotes-h" class="quotes__h reveal">Lo que dicen nuestros clientes</h2>
      <div class="quotes__grid">
        {testimonials.map((t) => (
          <figure class="quote reveal">
            <p class="quote__stars" role="img" aria-label="5 de 5 estrellas">
              {[0, 1, 2, 3, 4].map(() => <Glyph name="star" />)}
            </p>
            <blockquote><p>{t.quote}</p></blockquote>
            <figcaption>{t.title}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA contacto -->
  <section class="section section--dark on-dark contact" id="contacto" aria-labelledby="contacto-h">
    <div class="container contact__grid">
      <div class="contact__text reveal">
        <h2 id="contacto-h">¿Hablamos?<br />Sin compromiso.</h2>
        <p>Escríbenos por WhatsApp y un asesor te responde. Cuéntanos qué carro buscas o cuál quieres vender.</p>
        <a href="https://www.instagram.com/autocapital.co/" class="contact__ig" target="_blank" rel="noopener">
          <Glyph name="instagram" /> Síguenos en Instagram · @autocapital.co
        </a>
      </div>
      <form class="contact__form reveal" data-wa-form data-wa-number={whatsappNumber} data-wa-intro="Hola AutoCapital, les escribo desde la web.">
        <div class="field">
          <label for="c-nombre">Nombre</label>
          <input id="c-nombre" name="nombre" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="c-tel">Teléfono</label>
          <input id="c-tel" name="telefono" type="tel" autocomplete="tel" inputmode="tel" required />
        </div>
        <fieldset class="field contact__interest">
          <legend class="label">Me interesa</legend>
          <div class="chips">
            {['Comprar', 'Vender', 'Consignar', 'Financiar'].map((o, i) => (
              <label class="chip"><input type="radio" name="interes" value={o} data-label="Me interesa" checked={i === 0} /><span>{o}</span></label>
            ))}
          </div>
        </fieldset>
        <div class="field contact__msg">
          <label for="c-msg">Mensaje (opcional)</label>
          <textarea id="c-msg" name="mensaje" rows="3" placeholder="Ej.: busco una SUV automática 2021 en adelante"></textarea>
        </div>
        <div class="contact__submit">
          <button type="submit" class="btn btn--primary"><Glyph name="whatsapp" /> Enviar por WhatsApp</button>
          <p class="form-note">Al enviar se abre WhatsApp con tu mensaje listo.</p>
        </div>
        <p class="form-ok" data-wa-status hidden role="status"></p>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  import { initWaForms } from '@/lib/waForm';
  initWaForms();
</script>

<style>
  /* Hero */
  .hero {
    background: var(--color-graphite);
    color: var(--color-on-dark);
    padding-top: calc(76px + clamp(2.5rem, 6vw, 5rem));
    padding-bottom: clamp(3rem, 7vw, 6rem);
    overflow: hidden;
  }
  .hero__grid { display: grid; gap: 3rem; align-items: center; }
  @media (min-width: 1024px) { .hero__grid { grid-template-columns: 1.2fr 0.8fr; gap: 4.5rem; } }
  .hero__text { display: grid; gap: 1.6rem; }
  .hero__status { display: inline-flex; align-items: center; gap: 0.6rem; font-size: var(--text-small); color: var(--color-on-dark-muted); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--color-signal); box-shadow: 0 0 0 4px rgba(47, 182, 124, 0.18); }
  .hero h1 { font-size: var(--text-display); line-height: 0.98; letter-spacing: -0.035em; font-weight: 600; max-width: 13ch; }
  .hero__lead { font-size: var(--text-lead); color: var(--color-on-dark-muted); max-width: 34rem; line-height: 1.5; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.5rem; }

  .hero__car { display: block; color: var(--color-on-dark); max-width: 30rem; width: 100%; justify-self: center; }
  @media (min-width: 1024px) { .hero__car { justify-self: end; } }
  .hero__photo { aspect-ratio: 4 / 4.4; border-radius: var(--radius-md); overflow: hidden; background: #0e1422; }
  .hero__photo :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 65%; transition: transform 1.2s var(--ease-out); }
  .hero__car:hover .hero__photo :global(img) { transform: scale(1.03); }
  .hero__spec { display: grid; grid-template-columns: repeat(2, 1fr); margin-top: 1px; border-top: 1px solid var(--color-line-dark); }
  .hero__spec div { padding: 0.8rem 0; border-bottom: 1px solid var(--color-line-dark); }
  .hero__spec div:nth-child(even) { padding-left: 1rem; border-left: 1px solid var(--color-line-dark); }
  .hero__spec dt { font-size: var(--text-xs); color: var(--color-on-dark-muted); }
  .hero__spec dd { font-size: 0.95rem; }
  .hero__car:hover { color: #fff; }

  /* Servicios */
  .services__grid { display: grid; gap: 2.5rem; }
  @media (min-width: 1024px) { .services__grid { grid-template-columns: 0.8fr 1.2fr; gap: 5rem; } .services__head { position: sticky; top: 120px; align-self: start; } }
  .services__head { display: grid; gap: 1rem; }
  .services__head p { color: var(--color-ink-500); font-size: var(--text-lead); line-height: 1.5; max-width: 26rem; }
  .services__list { list-style: none; border-top: 1px solid var(--color-ink); }
  .service {
    display: grid;
    gap: 0.4rem 2rem;
    padding: 1.6rem 0;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-ink);
  }
  @media (min-width: 640px) { .service { grid-template-columns: 1fr auto; } .service__text { grid-column: 1; } .service__cta { grid-column: 2; grid-row: 1 / span 2; align-self: center; } }
  .service__title { font-size: clamp(1.4rem, 2.4vw, 1.9rem); font-weight: 600; letter-spacing: -0.025em; line-height: 1.15; transition: transform 0.45s var(--ease-out); }
  .service__text { color: var(--color-ink-500); max-width: 40ch; }
  .service__cta { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 560; font-size: 0.95rem; color: var(--color-brand-ink); white-space: nowrap; }
  .service__cta :global(svg) { width: 1.1rem; height: 1.1rem; transition: transform 0.35s var(--ease-out); }
  .service:hover { color: var(--color-ink); }
  .service:hover .service__title { transform: translateX(6px); }
  .service:hover .service__cta :global(svg) { transform: translateX(5px); }

  /* Recién llegados */
  .row-head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 2.25rem; }
  .grid-cars { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); }
  @media (min-width: 1100px) { .grid-cars { grid-template-columns: repeat(3, 1fr); gap: 1.5rem; } }

  /* Quiénes somos */
  .about__grid { display: grid; gap: 3rem; }
  @media (min-width: 1024px) { .about__grid { grid-template-columns: 1fr 1fr; gap: 5rem; } }
  .about__text { display: grid; gap: 1.1rem; align-content: start; max-width: 34rem; }
  .about__text h2 { margin-bottom: 0.5rem; }
  .about__lead { font-size: clamp(1.4rem, 2.4vw, 1.85rem); font-weight: 560; letter-spacing: -0.02em; line-height: 1.25; }
  .about__text p:not(.about__lead) { color: var(--color-ink-700); }
  .about__pillars { display: grid; gap: 0; align-content: start; }
  @media (min-width: 640px) { .about__pillars { grid-template-columns: 1fr 1fr; column-gap: 2rem; } }
  .about__pillars div { padding: 1.4rem 0 1.6rem; border-top: 1px solid var(--color-line); display: grid; gap: 0.45rem; }
  .about__pillars dt { font-weight: 600; font-size: 1.08rem; letter-spacing: -0.01em; }
  .about__pillars dd { color: var(--color-ink-500); font-size: 0.96rem; }

  /* Testimonios */
  .quotes { border-top: 1px solid var(--color-line); }
  .quotes__h { font-size: var(--text-h3); margin-bottom: 2.25rem; }
  .quotes__grid { display: grid; gap: 2.5rem; }
  @media (min-width: 900px) { .quotes__grid { grid-template-columns: repeat(3, 1fr); gap: 0; } .quote { padding-inline: 2rem; } .quote:first-child { padding-left: 0; } .quote + .quote { border-left: 1px solid var(--color-line); } }
  .quote { display: grid; gap: 1rem; align-content: start; }
  .quote__stars { display: flex; gap: 2px; color: var(--color-brand); }
  .quote__stars :global(svg) { width: 0.95rem; height: 0.95rem; }
  .quote blockquote p { font-size: 1.08rem; line-height: 1.55; letter-spacing: -0.005em; }
  .quote figcaption { font-size: var(--text-small); color: var(--color-ink-500); font-weight: 540; }

  /* Contacto */
  .contact__grid { display: grid; gap: 3rem; }
  @media (min-width: 1024px) { .contact__grid { grid-template-columns: 0.9fr 1.1fr; gap: 5rem; } }
  .contact__text { display: grid; gap: 1.25rem; align-content: start; }
  .contact__text h2 { font-size: var(--text-h1); line-height: 1.02; }
  .contact__text p { color: var(--color-on-dark-muted); font-size: var(--text-lead); line-height: 1.5; max-width: 30rem; }
  .contact__ig { display: inline-flex; align-items: center; gap: 0.6rem; color: var(--color-on-dark); font-weight: 520; }
  .contact__ig :global(svg) { width: 1.2rem; height: 1.2rem; }
  .contact__ig:hover { color: #fff; text-decoration: underline; }
  .contact__form { display: grid; gap: 1.1rem; grid-template-columns: 1fr; }
  @media (min-width: 640px) { .contact__form { grid-template-columns: 1fr 1fr; } .contact__interest, .contact__msg, .contact__submit, .form-ok { grid-column: 1 / -1; } }
  fieldset { border: 0; min-width: 0; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip { position: relative; cursor: pointer; }
  .chip input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .chip span {
    display: inline-flex;
    align-items: center;
    height: 2.6rem;
    padding: 0 1.1rem;
    border: 1px solid rgba(242, 241, 237, 0.24);
    border-radius: var(--radius-sm);
    font-size: 0.93rem;
    transition: background-color 0.2s var(--ease-out), color 0.2s var(--ease-out), border-color 0.2s var(--ease-out);
  }
  .chip:hover span { border-color: rgba(242, 241, 237, 0.55); }
  .chip input:checked + span { background: var(--color-on-dark); color: var(--color-ink); border-color: var(--color-on-dark); }
  .chip input:focus-visible + span { outline: 2px solid var(--color-brand); outline-offset: 2px; }
  .contact__submit { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-top: 0.4rem; }
  .form-ok { font-size: var(--text-small); color: #7fd9ad; }
</style>

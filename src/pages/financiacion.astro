---
// src/pages/financiacion.astro — Simulador de cuota + solicitud de preaprobación
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageIntro from '@/components/ui/PageIntro.astro';
import Steps from '@/components/ui/Steps.astro';
import CrossLink from '@/components/ui/CrossLink.astro';
import Glyph from '@/components/ui/Glyph.astro';
import { inventory } from '@/data/inventory';
import { whatsappNumber } from '@/data/site';
import { formatCOP } from '@/lib/url';

const title = 'Financia tu carro | Simulador de cuota | AutoCapital';
const description =
  'Simula la cuota de tu próximo carro y solicita tu preaprobación de crédito con AutoCapital. Te acompañamos en todo el trámite de financiación.';

// Tasa de referencia (placeholder a validar con AutoCapital)
const RATE = 1.6; // % mensual vencido
const sim = { valor: 120_000_000, min: 30_000_000, max: 400_000_000, step: 100_000, inicial: 30, plazos: [24, 36, 48, 60, 72], plazo: 60 };

const steps = [
  { title: 'Simula', text: 'Define valor, cuota inicial y plazo.' },
  { title: 'Envía tus datos', text: 'Te pedimos lo mínimo para estudiar tu crédito.' },
  { title: 'Preaprobación', text: 'Presentamos tu solicitud a nuestras entidades aliadas.' },
  { title: 'Estrena', text: 'Firmas, gestionamos el traspaso y te entregamos el carro.' },
];
---

<BaseLayout headerVariant="overlay" title={title} description={description} waMessage="Hola AutoCapital, quiero información sobre financiación.">
  <PageIntro
    crumb="Financiación"
    heading="Estrena sin pagarlo todo hoy"
    intro="Simula tu cuota en segundos y te acompañamos en la solicitud con nuestras entidades aliadas."
    image="hero-financiacion.jpg"
    imageAlt="Mercedes-Benz coupé en una carretera costera al atardecer"
    imagePosition="55% 62%"
  >
    <a href="#simulador" class="btn btn--primary">Simular mi cuota</a>
  </PageIntro>

  <section class="section sim-sec" id="simulador" aria-labelledby="sim-h">
    <div class="container">
      <div class="sim" data-sim data-rate={RATE}>
        <form class="sim__inputs" aria-labelledby="sim-h" onsubmit="return false">
          <h2 id="sim-h">Simula tu cuota</h2>

          <div class="range">
            <div class="range__top">
              <label for="s-valor">Valor del vehículo</label>
              <output for="s-valor" class="num" data-out="valor">{formatCOP(sim.valor)}</output>
            </div>
            <input type="range" id="s-valor" name="valor" min={sim.min} max={sim.max} step={sim.step} value={sim.valor} />
            <div class="range__scale num"><span>{formatCOP(sim.min)}</span><span>{formatCOP(sim.max)}</span></div>
          </div>

          <div class="range">
            <div class="range__top">
              <label for="s-inicial">Cuota inicial</label>
              <output for="s-inicial" class="num" data-out="inicial">{sim.inicial}%</output>
            </div>
            <input type="range" id="s-inicial" name="inicial" min="10" max="70" step="5" value={sim.inicial} />
            <div class="range__scale num"><span>10%</span><span>70%</span></div>
          </div>

          <fieldset class="plazo">
            <legend>Plazo</legend>
            <div class="plazo__opts">
              {sim.plazos.map((p) => (
                <label><input type="radio" name="plazo" value={p} checked={p === sim.plazo} /><span class="num">{p} meses</span></label>
              ))}
            </div>
          </fieldset>
        </form>

        <div class="sim__result on-dark" aria-live="polite">
          <p class="sim__label">Cuota mensual estimada</p>
          <p class="sim__cuota num" data-out="cuota">—</p>
          <dl class="sim__list">
            <div><dt>Cuota inicial</dt><dd class="num" data-out="inicialCOP">—</dd></div>
            <div><dt>Monto a financiar</dt><dd class="num" data-out="monto">—</dd></div>
            <div><dt>Tasa de referencia</dt><dd class="num">{RATE.toLocaleString('es-CO')}% m.v.</dd></div>
          </dl>
          <a href="#solicitud" class="btn btn--primary sim__cta">Solicitar preaprobación <Glyph name="arrow" /></a>
          <p class="sim__disclaimer">Valores orientativos. La tasa, la cuota y la aprobación final dependen de la entidad financiera y de tu perfil crediticio.</p>
        </div>
      </div>
    </div>
  </section>

  <Steps heading="Cómo funciona" items={steps} dark />

  <section class="section section--tight" aria-labelledby="aliados-h">
    <div class="container partners">
      <div class="reveal">
        <h2 id="aliados-h">Entidades aliadas</h2>
        <p>Trabajamos con bancos y financieras para encontrar la opción que mejor se ajuste a tu perfil.</p>
      </div>
      <ul class="partners__list" aria-label="Logos de entidades aliadas (pendientes)">
        {[1, 2, 3, 4].map((n) => <li><span>Aliado {n}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="section section--paper" id="solicitud" aria-labelledby="solicitud-h">
    <div class="container apply">
      <div class="apply__text reveal">
        <h2 id="solicitud-h">Solicita tu preaprobación</h2>
        <p>Te contactamos por WhatsApp con los siguientes pasos. Incluimos los valores que simulaste.</p>
      </div>
      <form class="apply__form reveal" data-wa-form data-wa-number={whatsappNumber} data-wa-intro="Hola AutoCapital, quiero solicitar preaprobación de crédito:" data-apply>
        <div class="field"><label for="a-nombre">Nombre</label><input id="a-nombre" name="nombre" required autocomplete="name" /></div>
        <div class="field"><label for="a-tel">Teléfono / WhatsApp</label><input id="a-tel" name="telefono" type="tel" required autocomplete="tel" inputmode="tel" /></div>
        <div class="field"><label for="a-ciudad">Ciudad</label><input id="a-ciudad" name="ciudad" required autocomplete="address-level2" placeholder="Bogotá" /></div>
        <div class="field">
          <label for="a-ingreso">Tipo de ingreso</label>
          <select id="a-ingreso" name="ingreso" required>
            <option value="">Selecciona</option>
            <option>Empleado</option>
            <option>Independiente</option>
            <option>Pensionado</option>
          </select>
        </div>
        <div class="field apply__wide">
          <label for="a-carro">Carro de interés (opcional)</label>
          <select id="a-carro" name="carro">
            <option value="">Aún no lo he elegido</option>
            {inventory.map((c) => <option value={c.slug}>{c.name} {c.year} · {formatCOP(c.priceCOP)}</option>)}
          </select>
        </div>
        <input type="text" name="simulacion" data-label="Simulación" class="sr-only" tabindex="-1" aria-hidden="true" data-sim-summary />
        <div class="apply__wide apply__submit">
          <button type="submit" class="btn btn--primary"><Glyph name="whatsapp" /> Enviar solicitud</button>
          <p class="form-note">Se abre WhatsApp con tu solicitud y la simulación.</p>
        </div>
        <p class="form-ok apply__wide" data-wa-status hidden role="status"></p>
      </form>
    </div>
  </section>

  <section class="section--tight">
    <div class="container">
      <CrossLink heading="¿Ya sabes qué carro quieres?" text="Revisa el inventario disponible." label="Ver catálogo" href="/catalogo" />
    </div>
  </section>
</BaseLayout>

<script>
  import { initWaForms } from '@/lib/waForm';

  const root = document.querySelector<HTMLElement>('[data-sim]');
  const cop = (n: number) => '$' + Math.round(n).toLocaleString('es-CO');
  if (root) {
    const rate = Number(root.dataset.rate) / 100;
    const form = root.querySelector('form')!;
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
    const summary = document.querySelector<HTMLInputElement>('[data-sim-summary]');
    const carSel = document.querySelector<HTMLSelectElement>('#a-carro');

    // La cuota "corre" hasta su nuevo valor: deja ver cuánto cambió con cada ajuste
    const cuotaEl = out('cuota');
    const calm = window.matchMedia('(prefers-reduced-motion: reduce)');
    let shown = 0, raf = 0;
    const tween = (to: number) => {
      cancelAnimationFrame(raf);
      if (calm.matches || !shown) { shown = to; cuotaEl.textContent = cop(to); return; }
      const from = shown, t0 = performance.now(), dur = 420;
      cuotaEl.classList.toggle('is-up', to > from);
      cuotaEl.classList.toggle('is-down', to < from);
      const step = (t: number) => {
        const k = Math.min(1, (t - t0) / dur);
        const e = 1 - Math.pow(1 - k, 4);
        shown = from + (to - from) * e;
        cuotaEl.textContent = cop(shown);
        if (k < 1) raf = requestAnimationFrame(step);
        else cuotaEl.classList.remove('is-up', 'is-down');
      };
      raf = requestAnimationFrame(step);
    };

    const calc = () => {
      const f = new FormData(form);
      const valor = Number(f.get('valor'));
      const pct = Number(f.get('inicial'));
      const n = Number(f.get('plazo'));
      const inicial = valor * pct / 100;
      const monto = valor - inicial;
      const cuota = rate === 0 ? monto / n : (monto * rate) / (1 - Math.pow(1 + rate, -n));

      out('valor').textContent = cop(valor);
      out('inicial').textContent = `${pct}%`;
      out('inicialCOP').textContent = cop(inicial);
      out('monto').textContent = cop(monto);
      tween(cuota);

      // Relleno del track
      form.querySelectorAll<HTMLInputElement>('input[type=range]').forEach((r) => {
        const p = ((Number(r.value) - Number(r.min)) / (Number(r.max) - Number(r.min))) * 100;
        r.style.setProperty('--p', `${p}%`);
      });

      if (summary) summary.value = `vehículo ${cop(valor)}, inicial ${pct}% (${cop(inicial)}), ${n} meses, cuota aprox. ${cop(cuota)}`;
    };

    form.addEventListener('input', calc);
    form.addEventListener('change', calc);
    // Elegir un carro del inventario ajusta el valor del simulador
    carSel?.addEventListener('change', () => {
      const opt = carSel.selectedOptions[0];
      const m = opt?.textContent?.match(/\$([\d.]+)/);
      if (m) {
        const v = Number(m[1].replace(/\./g, ''));
        const range = form.querySelector<HTMLInputElement>('#s-valor')!;
        range.value = String(Math.min(Number(range.max), Math.max(Number(range.min), v)));
        calc();
      }
    });
    calc();
  }
  initWaForms();
</script>

<style>
  .sim-sec { padding-top: clamp(2.5rem, 5vw, 4rem); }
  .sim__cuota { transition: color 0.3s ease; }
  .sim__cuota:global(.is-up) { color: #f6a08b; }
  .sim__cuota:global(.is-down) { color: #8fe0b8; }
  .sim { display: grid; gap: 2rem; align-items: stretch; }
  @media (min-width: 1024px) { .sim { grid-template-columns: 1.25fr 1fr; gap: 3.5rem; } }
  .sim__inputs { display: grid; gap: 2.25rem; align-content: start; }
  .sim__inputs h2 { font-size: var(--text-h2); }

  .range { display: grid; gap: 0.8rem; }
  .range__top { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  .range__top label { font-weight: 560; }
  .range__top output { font-size: clamp(1.2rem, 2vw, 1.5rem); font-weight: 500; }
  .range__scale { display: flex; justify-content: space-between; font-size: var(--text-xs); color: var(--color-ink-500); }
  input[type='range'] {
    --p: 50%;
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 28px;
    background: transparent;
    cursor: pointer;
  }
  input[type='range']::-webkit-slider-runnable-track { height: 3px; border-radius: 2px; background: linear-gradient(to right, var(--color-ink) var(--p), var(--color-line) var(--p)); }
  input[type='range']::-moz-range-track { height: 3px; border-radius: 2px; background: var(--color-line); }
  input[type='range']::-moz-range-progress { height: 3px; background: var(--color-ink); }
  input[type='range']::-webkit-slider-thumb { -webkit-appearance: none; width: 22px; height: 22px; margin-top: -9.5px; border-radius: 50%; background: var(--color-paper); border: 2px solid var(--color-ink); box-shadow: var(--shadow-sm); transition: transform 0.2s var(--ease-out); }
  input[type='range']::-moz-range-thumb { width: 18px; height: 18px; border-radius: 50%; background: var(--color-paper); border: 2px solid var(--color-ink); }
  input[type='range']:active::-webkit-slider-thumb { transform: scale(1.12); }
  input[type='range']:focus-visible { outline: none; }
  input[type='range']:focus-visible::-webkit-slider-thumb { outline: 2px solid var(--color-brand); outline-offset: 3px; }

  .plazo { border: 0; min-width: 0; display: grid; gap: 0.8rem; }
  .plazo legend { font-weight: 560; margin-bottom: 0.8rem; }
  .plazo__opts { display: grid; grid-template-columns: repeat(auto-fit, minmax(6.5rem, 1fr)); gap: 0.5rem; }
  .plazo__opts label { position: relative; cursor: pointer; }
  .plazo__opts input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .plazo__opts span { display: grid; place-items: center; height: 2.9rem; border: 1px solid var(--color-line); border-radius: var(--radius-sm); background: var(--color-paper); font-size: 0.9rem; transition: all 0.2s var(--ease-out); }
  .plazo__opts label:hover span { border-color: #b3b0a7; }
  .plazo__opts input:checked + span { background: var(--color-ink); border-color: var(--color-ink); color: var(--color-surface); }
  .plazo__opts input:focus-visible + span { outline: 2px solid var(--color-brand); outline-offset: 2px; }

  .sim__result {
    display: grid;
    gap: 1rem;
    align-content: start;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: var(--radius-md);
    background: var(--color-graphite);
    color: var(--color-on-dark);
  }
  .sim__label { font-size: var(--text-small); color: var(--color-on-dark-muted); }
  .sim__cuota { font-size: clamp(2.4rem, 5vw, 3.6rem); font-weight: 500; letter-spacing: -0.04em; line-height: 1; }
  .sim__list { margin-top: 0.5rem; }
  .sim__list div { display: flex; justify-content: space-between; gap: 1rem; padding: 0.75rem 0; border-top: 1px solid var(--color-line-dark); font-size: 0.95rem; }
  .sim__list dt { color: var(--color-on-dark-muted); }
  .sim__cta { margin-top: 0.5rem; }
  .sim__disclaimer { font-size: var(--text-xs); color: var(--color-on-dark-muted); line-height: 1.5; }

  .partners { display: grid; gap: 2rem; }
  @media (min-width: 1024px) { .partners { grid-template-columns: 0.85fr 1.15fr; gap: 4.5rem; align-items: center; } }
  .partners h2 { font-size: var(--text-h3); margin-bottom: 0.6rem; }
  .partners p { color: var(--color-ink-500); }
  .partners__list { list-style: none; display: grid; grid-template-columns: repeat(2, 1fr); gap: 0; border-top: 1px solid var(--color-line); border-left: 1px solid var(--color-line); }
  @media (min-width: 640px) { .partners__list { grid-template-columns: repeat(4, 1fr); } }
  .partners__list li { display: grid; place-items: center; height: 5.5rem; border-right: 1px solid var(--color-line); border-bottom: 1px solid var(--color-line); }
  .partners__list span { font-size: var(--text-small); color: var(--color-ink-500); letter-spacing: 0.01em; }

  .apply { display: grid; gap: 2.5rem; }
  @media (min-width: 1024px) { .apply { grid-template-columns: 0.85fr 1.15fr; gap: 4.5rem; } }
  .apply__text { display: grid; gap: 1rem; align-content: start; }
  .apply__text p { color: var(--color-ink-500); font-size: var(--text-lead); line-height: 1.5; }
  .apply__form { display: grid; gap: 1.1rem; }
  @media (min-width: 640px) { .apply__form { grid-template-columns: 1fr 1fr; } .apply__wide { grid-column: 1 / -1; } }
  .apply__submit { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-top: 0.4rem; }
  .form-ok { font-size: var(--text-small); color: var(--color-success); }
</style>

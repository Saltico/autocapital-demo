---
// src/components/layout/Header.astro
// Header fijo: logo · navegación · CTA WhatsApp. Sobre hero oscuro arranca
// transparente (variant="overlay") y pasa a superficie clara al hacer scroll.
import type { NavItem } from '@/types/navigation';
import Glyph from '@/components/ui/Glyph.astro';
import { siteBrand, whatsappLink } from '@/data/site';
import { href, stripBase } from '@/lib/url';

export interface Props {
  items: NavItem[];
  variant?: 'solid' | 'overlay';
}

const { items, variant = 'solid' } = Astro.props;
const current = stripBase(Astro.url.pathname).replace(/\/$/, '') || '/';
const isActive = (url: string) => !url.includes('#') && url === current;
const wa = whatsappLink('Hola AutoCapital, quiero más información.');
---

<header class:list={['header', `header--${variant}`]} data-header>
  <div class="header__inner">
    <a href={href('/')} class="header__logo" aria-label={`${siteBrand.name}, ir al inicio`}>
      <img src={href(siteBrand.logoUrl)} alt={siteBrand.name} width="509" height="248" loading="eager" decoding="async" />
    </a>

    <nav class="header__nav" aria-label="Principal">
      <ul>
        {items.map((item) => (
          <li>
            <a href={href(item.url)} aria-current={isActive(item.url) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header__actions">
      <a href={wa} class="header__wa" target="_blank" rel="noopener">
        <Glyph name="whatsapp" />
        <span>Escríbenos</span>
      </a>
      <button type="button" class="header__toggle" aria-expanded="false" aria-controls="menu-movil" data-menu-toggle>
        <span class="sr-only">Abrir menú</span>
        <span class="header__bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <dialog id="menu-movil" class="drawer" aria-label="Menú" data-menu>
    <div class="drawer__top">
      <img src={href(siteBrand.logoUrl)} alt="" width="509" height="248" />
      <button type="button" class="drawer__close" data-menu-close>
        <span class="sr-only">Cerrar menú</span>
        <span aria-hidden="true" class="drawer__x"></span>
      </button>
    </div>
    <ul class="drawer__list">
      {items.map((item) => (
        <li>
          <a href={href(item.url)} aria-current={isActive(item.url) ? 'page' : undefined}>
            {item.label}
            <Glyph name="arrow" />
          </a>
        </li>
      ))}
    </ul>
    <a href={wa} class="btn btn--primary drawer__cta" target="_blank" rel="noopener">
      <Glyph name="whatsapp" /> Escríbenos por WhatsApp
    </a>
  </dialog>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    height: 76px;
    color: var(--color-ink);
    background: color-mix(in srgb, var(--color-surface) 92%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--color-line);
    transition: background-color 0.35s var(--ease-out), color 0.35s var(--ease-out), border-color 0.35s var(--ease-out), transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  /* Se esconde al bajar y vuelve al subir: más foto, menos barra */
  .header.is-hidden { transform: translateY(-100%); }
  .header:focus-within { transform: none; }

  /* Overlay: sobre el hero oscuro de la home */
  .header--overlay {
    position: fixed;
    inset: 0 0 auto 0;
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom-color: transparent;
    color: var(--color-on-dark);
  }
  .header--overlay.is-scrolled {
    background: color-mix(in srgb, var(--color-surface) 92%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
    border-bottom-color: var(--color-line);
    color: var(--color-ink);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    max-width: var(--breakpoint-xl);
    height: 100%;
    margin-inline: auto;
    padding-inline: 1.25rem;
  }
  @media (min-width: 768px) { .header__inner { padding-inline: var(--spacing-8); } }

  .header__logo { flex-shrink: 0; line-height: 0; }
  .header__logo img { height: 40px; width: auto; }

  .header__nav { flex: 1; display: none; justify-content: center; }
  @media (min-width: 1024px) { .header__nav { display: flex; } }
  .header__nav ul { display: flex; gap: 0.25rem; list-style: none; }
  .header__nav a {
    position: relative;
    display: block;
    padding: 0.55rem 0.8rem;
    font-size: 0.93rem;
    font-weight: 500;
    color: inherit;
    opacity: 0.82;
    transition: opacity 0.2s var(--ease-out);
  }
  .header__nav a::after {
    content: '';
    position: absolute;
    left: 0.8rem;
    right: 0.8rem;
    bottom: 0.25rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease-out);
  }
  .header__nav a:hover { opacity: 1; }
  .header__nav a:hover::after,
  .header__nav a[aria-current='page']::after { transform: scaleX(1); }
  .header__nav a[aria-current='page'] { opacity: 1; }

  .header__actions { display: flex; align-items: center; gap: 0.5rem; margin-left: auto; }
  @media (min-width: 1024px) { .header__actions { margin-left: 0; } }

  .header__wa {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.6rem;
    padding: 0 1rem;
    border-radius: var(--radius-sm);
    background: var(--color-brand-600);
    color: #fff;
    font-weight: 560;
    font-size: 0.92rem;
    transition: background-color 0.2s var(--ease-out);
  }
  .header__wa:hover { background: var(--color-brand-700); color: #fff; }
  .header__wa :global(svg) { width: 1.1rem; height: 1.1rem; }
  @media (max-width: 479px) { .header__wa span { display: none; } .header__wa { padding: 0 0.75rem; } }

  .header__toggle {
    display: inline-grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid currentColor;
    border-radius: var(--radius-sm);
    opacity: 0.85;
  }
  @media (min-width: 1024px) { .header__toggle { display: none; } }
  .header__bars, .header__bars::before, .header__bars::after {
    display: block;
    width: 1.1rem;
    height: 1.5px;
    background: currentColor;
    position: relative;
  }
  .header__bars::before, .header__bars::after { content: ''; position: absolute; left: 0; }
  .header__bars::before { top: -5px; }
  .header__bars::after { top: 5px; }

  /* Drawer móvil */
  .drawer {
    width: min(88vw, 380px);
    height: 100dvh;
    max-height: 100dvh;
    margin: 0 0 0 auto;
    padding: 1.25rem;
    border: 0;
    background: var(--color-surface);
    color: var(--color-ink);
    display: none;
    flex-direction: column;
    gap: 1.5rem;
  }
  .drawer[open] { display: flex; animation: drawer-in 0.45s var(--ease-out); }
  @keyframes drawer-in { from { transform: translateX(24px); opacity: 0; } }
  .drawer::backdrop { background: rgba(12, 19, 34, 0.5); }
  .drawer__top { display: flex; align-items: center; justify-content: space-between; }
  .drawer__top img { height: 36px; width: auto; }
  .drawer__close { width: 2.6rem; height: 2.6rem; display: grid; place-items: center; border: 1px solid var(--color-line); border-radius: var(--radius-sm); }
  .drawer__x, .drawer__x::after { display: block; width: 1.1rem; height: 1.5px; background: currentColor; transform: rotate(45deg); }
  .drawer__x::after { content: ''; transform: rotate(90deg); }
  .drawer__list { list-style: none; border-top: 1px solid var(--color-line); }
  .drawer__list a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.05rem 0;
    border-bottom: 1px solid var(--color-line);
    font-size: 1.35rem;
    font-weight: 560;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }
  .drawer__list a :global(svg) { width: 1.2rem; height: 1.2rem; color: var(--color-ink-500); }
  .drawer__list a[aria-current='page'] { color: var(--color-brand-ink); }
  .drawer__cta { margin-top: auto; width: 100%; }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    let last = window.scrollY;
    const onScroll = () => {
      const y = window.scrollY;
      header.classList.toggle('is-scrolled', y > 24);
      if (Math.abs(y - last) > 6) {
        header.classList.toggle('is-hidden', y > last && y > 480);
        last = y;
      }
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
  const dialog = document.querySelector<HTMLDialogElement>('[data-menu]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const close = document.querySelector<HTMLButtonElement>('[data-menu-close]');
  if (dialog && toggle) {
    toggle.addEventListener('click', () => { dialog.showModal(); toggle.setAttribute('aria-expanded', 'true'); });
    close?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    dialog.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => dialog.close()));
    dialog.addEventListener('close', () => { toggle.setAttribute('aria-expanded', 'false'); toggle.focus(); });
  }
</script>

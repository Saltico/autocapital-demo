---
// src/components/ui/CrossLink.astro
// Banda de enlace interno hacia otra página del sitio.
import Glyph from '@/components/ui/Glyph.astro';
import { href as withBase } from '@/lib/url';

export interface Props {
  heading: string;
  text?: string;
  label: string;
  href: string;
  external?: boolean;
}
const { heading, text, label, href, external = false } = Astro.props;
---
<a class="xlink reveal" href={withBase(href)} {...(external ? { target: '_blank', rel: 'noopener' } : {})}>
  <span class="xlink__text">
    <span class="xlink__heading">{heading}</span>
    {text && <span class="xlink__sub">{text}</span>}
  </span>
  <span class="xlink__cta">{label} <Glyph name="arrow" /></span>
</a>

<style>
  .xlink {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding: clamp(1.5rem, 3vw, 2.25rem) 0;
    border-top: 1px solid var(--color-line);
    color: var(--color-ink);
  }
  .xlink:last-child { border-bottom: 1px solid var(--color-line); }
  .xlink + .xlink { border-top: 1px solid var(--color-line); }
  .xlink__text { display: grid; gap: 0.3rem; }
  .xlink__heading { font-size: var(--text-h3); font-weight: 600; letter-spacing: -0.02em; line-height: 1.2; }
  .xlink__sub { color: var(--color-ink-500); }
  .xlink__cta { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 560; color: var(--color-brand-ink); }
  .xlink__cta :global(svg) { width: 1.15rem; height: 1.15rem; transition: transform 0.35s var(--ease-out); }
  .xlink:hover { color: var(--color-ink); }
  .xlink:hover .xlink__cta :global(svg) { transform: translateX(5px); }
</style>

---
// src/components/ui/PageIntro.astro
// Cabecera de página interna: miga de pan + título + intro, con foto opcional.
import Img from '@/components/ui/Img.astro';
import { href } from '@/lib/url';

export interface Props {
  crumb: string;
  heading: string;
  intro: string;
  image?: string;
  imageAlt?: string;
  imagePosition?: string;
}
const { crumb, heading, intro, image, imageAlt = '', imagePosition = '50% 60%' } = Astro.props;
---

<section class:list={['intro on-dark', image && 'intro--media']}>
  <div class="container intro__grid">
    <div class="intro__text">
      <nav aria-label="Miga de pan" class="intro__crumb">
        <a href={href('/')}>Inicio</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{crumb}</span>
      </nav>
      <h1>{heading}</h1>
      <p class="intro__lead">{intro}</p>
      <div class="intro__actions"><slot /></div>
    </div>
    {image && (
      <div class="intro__media">
        <Img src={image} alt={imageAlt} priority sizes="(min-width: 1024px) 40vw, 100vw" widths={[480, 768, 1024]} style={`object-position:${imagePosition}`} />
      </div>
    )}
  </div>
</section>

<style>
  .intro {
    background: var(--color-graphite);
    color: var(--color-on-dark);
    padding-block: clamp(3.5rem, 8vw, 6.5rem) clamp(3rem, 7vw, 5.5rem);
    overflow: hidden;
  }
  .intro__grid { display: grid; gap: 2.5rem; align-items: end; }
  .intro--media .intro__grid { align-items: center; }
  @media (min-width: 1024px) {
    .intro--media .intro__grid { grid-template-columns: 1.15fr 0.85fr; gap: 4rem; }
  }
  .intro__text { display: grid; gap: 1.4rem; max-width: 44rem; }
  .intro__crumb { display: flex; gap: 0.55rem; font-size: var(--text-small); color: var(--color-on-dark-muted); }
  .intro__crumb a { color: var(--color-on-dark-muted); }
  .intro__crumb a:hover { color: var(--color-on-dark); }
  .intro__crumb [aria-current] { color: var(--color-on-dark); }
  .intro h1 { font-size: var(--text-h1); max-width: 16ch; }
  .intro__lead { font-size: var(--text-lead); line-height: 1.5; color: var(--color-on-dark-muted); max-width: 38rem; }
  .intro__actions:empty { display: none; }
  .intro__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.4rem; }
  .intro__media {
    border-radius: var(--radius-md);
    overflow: hidden;
    aspect-ratio: 4 / 3.3;
    background: #0e1422;
  }
  .intro__media :global(img) { width: 100%; height: 100%; object-fit: cover; }
</style>
